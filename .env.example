# ORZARYN — environment template (copy to .env, never commit .env)
# Production subdomain: https://orzaryn.svalley.tech

# DB: SQLite path is relative to prisma/ (so ../db/custom.db => <repo>/db/custom.db)
DATABASE_URL="file:../db/custom.db"

# Auth — generate: openssl rand -hex 32
SESSION_SECRET="change_me_to_a_64_char_random_secret_for_production"

# App
APP_ENV="production"
APP_URL="https://orzaryn.svalley.tech"

# Solana Devnet (Alchemy serves mainnet-beta + devnet; "testnet" is the validator cluster)
NETWORK="solana-devnet"
# Circle's DEVNET USDC mint (faucet-issued, no real value)
USDC_MINT_TESTNET="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"

# Alchemy Solana
ALCHEMY_RPC_HOST="https://solana-devnet.g.alchemy.com/v2"
ALCHEMY_APP_ID="q15y93g86sfgd0rb"
ALCHEMY_API_KEY="change_me_to_your_alchemy_api_key"

# Alchemy webhooks — REQUIRED in prod, otherwise events dead-letter as unverified (SF-4)
ALCHEMY_WEBHOOK_SECRET="change_me_to_your_webhook_signing_secret"

# Platform fee — keep 0 until pricing is validated
PLATFORM_FEE_BPS="0"
